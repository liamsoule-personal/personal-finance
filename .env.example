# Get these from https://dashboard.plaid.com → Team Settings → Keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_development_secret_here

# Use "development" for real Chase data, "sandbox" for fake test data
PLAID_ENV=development

# Path to the SQLite database (relative to the project root)
DATABASE_URL=sqlite:///data/ledger.db
